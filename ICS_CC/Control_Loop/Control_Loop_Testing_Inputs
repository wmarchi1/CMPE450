#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

RF24 radio(7, 6);  // CE, CSN
const byte address[6] = "00100";

float x_;
float y_;
float speed_;
float heading_;
struct DataPacket {
  float x;
  float y;
  float heading;
  float speed;
  int pwm;
};
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("Receiver Start");

  SPI.begin();
  delay(1000);
  radio.begin(&SPI);
  delay(1000);

  radio.openReadingPipe(1, address);
  delay(1000);
  radio.setPALevel(RF24_PA_MIN);
  delay(1000);
  radio.startListening();
  Serial.println("Receiver Ready");
}

void loop() {
  while (radio.available()) {
    // Read first float (avgRpm)
    DataPacket pkt;
    radio.read(&pkt, sizeof(pkt));
    x_ = pkt.x;
    y_ = pkt.y;
    speed_ = pkt.speed;
    heading_ = pkt.heading;
    pwm_ = pkt.pwm;
    // Print results
    Serial.print("Position (X,Y) (m): ( ");
    Serial.print(x_);
    Serial.print(" , ");
    Serial.print(y_);
    Serial.println(" )");
    Serial.print("Heading ");
    Serial.println(heading_);
    Serial.print("Velocity: ");
    Serial.println(speed_);
    Serial.print("PWM: ");
    Serial.println(pwm_);
  }

  //Serial.println("Not working");
}
